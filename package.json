{
  "name": "hina-ui",
  "version": "0.0.0",
  "scripts": {
    "test:browser": "pnpm --filter @hina-ui/vue test:browser",
    "format:check": "prettier --check .",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm --filter @hina-ui/vue test",
    "lint": "pnpm --filter @hina-ui/docs lint:check",
    "format": "prettier --write .",
    "build": "pnpm --filter @hina-ui/docs generate",
    "prepare": "husky && git config alias.sync-dev '!./scripts/git-sync-dev.sh' || true",
    "change": "node scripts/release/change.mjs",
    "release:preview": "node scripts/release/prepare.mjs --dry",
    "release:prepare": "node scripts/release/prepare.mjs",
    "release:check": "node --test scripts/release/*.test.mjs",
    "test:package": "pnpm --filter @hina-ui/vue build && node scripts/check-package.mjs",
    "test:docs": "node --test docs/changelog.test.ts"
  },
  "type": "module",
  "private": true,
  "packageManager": "pnpm@11.25.0",
  "devDependencies": {
    "husky": "^9.1.7",
    "lint-staged": "^17.4.1",
    "prettier": "^3.9.6"
  },
  "license": "MIT"
}
