{
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2023", "DOM", "DOM.Iterable", "ESNext.Disposable"],
    "strict": true,
    "skipLibCheck": false,
    "noEmit": true,
    "types": ["vite/client", "@types/web-bluetooth"]
  },
  "include": ["*.ts", "*.vue"]
}
