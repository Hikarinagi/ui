{
  "name": "@hina-ui/react",
  "version": "1.7.8",
  "description": "The design system behind Hikarinagi: React 19 components built on Tailwind CSS v4.",
  "keywords": [
    "react",
    "component-library",
    "design-system",
    "ui",
    "tailwindcss",
    "accessibility"
  ],
  "homepage": "https://react.hinaui.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Hikarinagi/ui.git",
    "directory": "packages/react"
  },
  "bugs": "https://github.com/Hikarinagi/ui/issues",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "module": "./dist/esm/react/src/index.js",
  "types": "./dist/types/react/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/react/src/index.d.ts",
      "import": "./dist/esm/react/src/index.js"
    },
    "./styles/tokens.css": "./dist/styles/tokens.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "!src/**/*.test.ts",
    "!src/**/*.test.tsx"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vite build && tsc -p tsconfig.build.json && node ../../scripts/package-shared.mjs react",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:browser": "vitest run -c vitest.browser.config.ts"
  },
  "dependencies": {
    "@floating-ui/react-dom": "2.1.8",
    "@internationalized/date": "^3.12.4",
    "@internationalized/number": "^3.6.8",
    "@tanstack/react-table": "9.2.4",
    "@tanstack/react-virtual": "3.14.10",
    "aria-hidden": "^1.2.6",
    "clsx": "^2.1.1",
    "embla-carousel": "8.6.0",
    "lucide-react": "1.41.0",
    "motion": "13.2.0",
    "overlayscrollbars": "2.16.0",
    "shiki": "4.0.2",
    "tailwind-merge": "^3.6.0",
    "tailwind-variants": "^3.3.1",
    "uqr": "0.1.3"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@floating-ui/dom": "1.7.6",
    "@hina-ui/shared": "workspace:*",
    "@tailwindcss/vite": "^4.3.0",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/browser": "^4.1.11",
    "@vitest/browser-playwright": "^4.1.11",
    "axe-core": "^4.13.0",
    "happy-dom": "^20.9.0",
    "jsqr": "1.4.0",
    "playwright": "^1.62.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwindcss": "^4.3.0",
    "typescript": "^5.8.0",
    "vite": "^8.2.2",
    "vitest": "^4.1.11",
    "vitest-browser-react": "^2.3.0"
  },
  "license": "MIT"
}
