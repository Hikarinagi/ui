{
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "jsx": "preserve",
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "baseUrl": ".",
    "paths": {
      "@hikarinagi/ui/*": ["src/*"]
    },
    "noEmit": true,
    "types": ["vite/client"]
  },
  "vueCompilerOptions": {
    "checkUnknownComponents": true
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.vue",
    "playground/**/*.ts",
    "playground/**/*.vue",
    "test/**/*.ts",
    "vite.config.ts",
    "vitest.config.ts",
    "vitest.browser.config.ts"
  ]
}
