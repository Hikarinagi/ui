{
  "name": "@hina-ui/vue",
  "version": "0.0.0",
  "description": "An elegant, restrained Vue 3 component library built on Reka UI and Tailwind CSS v4.",
  "keywords": [
    "vue",
    "vue3",
    "component-library",
    "design-system",
    "ui",
    "tailwindcss",
    "reka-ui",
    "accessibility"
  ],
  "homepage": "https://hinaui.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Hikarinagi/ui.git",
    "directory": "packages/vue"
  },
  "bugs": "https://github.com/Hikarinagi/ui/issues",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "module": "./dist/index.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles/tokens.css": "./src/styles/tokens.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "!src/**/*.test.ts"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vite build && vue-tsc -p tsconfig.build.json",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:browser": "vitest run -c vitest.browser.config.ts"
  },
  "dependencies": {
    "@internationalized/date": "^3.12.4",
    "@lucide/vue": "^1.37.0",
    "@vueuse/core": "^12.8.2",
    "clsx": "^2.1.1",
    "motion-v": "^2.2.1",
    "overlayscrollbars": "^2.16.0",
    "reka-ui": "^2.9.10",
    "shiki": "4.0.2",
    "tailwind-merge": "^3.6.0",
    "tailwind-variants": "^3.3.1"
  },
  "peerDependencies": {
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "@floating-ui/dom": "1.7.6",
    "@tailwindcss/vite": "^4.3.0",
    "@tanstack/vue-virtual": "^3.13.36",
    "@vitejs/plugin-vue": "^6.0.7",
    "@vitest/browser": "^4.1.11",
    "@vitest/browser-playwright": "^4.1.11",
    "@vue/test-utils": "^2.4.10",
    "axe-core": "^4.13.0",
    "happy-dom": "^20.9.0",
    "playwright": "^1.62.1",
    "tailwindcss": "^4.3.0",
    "typescript": "^5.8.0",
    "vite": "^8.2.2",
    "vitest": "^4.1.11",
    "vue": "^3.5.33",
    "vue-tsc": "^3.3.1"
  },
  "license": "MIT"
}
